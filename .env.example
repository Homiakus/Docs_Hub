# Docs Hub Next — environment variables
# Copy to .env and fill in values. NEVER commit .env to git.
#
# IMPORTANT: Docker --env-file does NOT support inline comments.
# Keep comments on separate lines only.

# Required
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-32-random-bytes

# Server
# ADDR — the address the app listens on inside the container.
# Do NOT change this to map a different host port.
ADDR=:8080
# HOST_PORT — external host port used by compose.yaml.
HOST_PORT=8080
# BIND_ADDR — host interface for compose.yaml. Use 127.0.0.1 behind a host reverse proxy.
BIND_ADDR=0.0.0.0
DATA_DIR=./data
SITE_NAME=Docs Hub Next
ADMIN_USER=admin

# Security
# Set to 1 for HTTPS
COOKIE_SECURE=0
# debug, info, warn, error
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_ENABLED=true
# Requests per minute per IP
RATE_LIMIT_RPM=60
# Burst size
RATE_LIMIT_BURST=10

# TLS (optional)
# TLS_ENABLED=1
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
