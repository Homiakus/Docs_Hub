# Docs Hub Next — environment variables
# Copy to .env and fill in values. NEVER commit .env to git.
#
# IMPORTANT: Docker --env-file does NOT support inline comments.
# Keep comments on separate lines only.

# ==============================================================================
# Admin Credentials (Required)
# ==============================================================================
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-hex-or-base64-bytes

# ==============================================================================
# Server & Storage Configuration
# ==============================================================================
# ADDR — internal listening address (:8080)
ADDR=:8080
# HOST_PORT — host port mapped in docker compose
HOST_PORT=8080
# BIND_ADDR — host bind IP (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
BIND_ADDR=0.0.0.0
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DB_PATH=./data/docshub.db
SITE_NAME=Docs Hub Next

# ==============================================================================
# Telegram Bot Notifications (Optional)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# ==============================================================================
# Security & Rate Limiting
# ==============================================================================
# Set to 1 or true when running behind HTTPS
COOKIE_SECURE=0
# Logging: debug, info, warn, error
LOG_LEVEL=info
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# ==============================================================================
# TLS / SSL (Optional - for direct HTTPS termination)
# ==============================================================================
# TLS_ENABLED=1
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
