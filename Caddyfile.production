{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy docshub:8080 {
		health_uri /healthz
		health_interval 30s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
